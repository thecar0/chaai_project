# NeonDB (postgresql://user:password@host/dbname?sslmode=require)
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 공공데이터 API (건축물대장 대조용 - 발급 전에는 비워둬도 앱은 정상 동작하고,
# "정부 데이터와 비교" 버튼을 누를 때만 에러 메시지로 안내됨)
# 1) 도로명주소 API 키: https://www.juso.go.kr (개발자센터 > 오픈API 신청)
JUSO_API_KEY=
# 2) 건축물대장정보 서비스 키: https://www.data.go.kr (국토교통부_건축물대장정보 서비스 검색 후 활용신청)
BUILDING_REGISTRY_API_KEY=

# 카카오 API (점검인력 배치 시 주소→좌표 변환 및 실제 주행거리 계산용 - 발급 전에는
# 배치 실행 시에만 에러 메시지로 안내됨)
# https://developers.kakao.com 에서 앱 생성 후 REST API 키 발급,
# "카카오맵"(주소 검색)과 "Mobility"(길찾기) 두 제품 모두 활성화 필요
KAKAO_REST_API_KEY=
